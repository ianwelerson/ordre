{
  "name": "@ordre/db",
  "version": "0.1.0",
  "dependencies": {
    "@ordre/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@ordre/config": "workspace:*",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "tsx": "^4.23.6",
    "typescript": "^6.0.3"
  },
  "exports": {
    "./connection": "./src/connection.ts",
    "./migrate": "./src/migrate.ts",
    "./schemas": "./src/schemas/index.ts"
  },
  "private": true,
  "scripts": {
    "auth:patch": "tsx scripts/patch-better-auth-schema.ts && prettier src/schemas/better-auth.ts --write",
    "check-types": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/seed.ts",
    "db:studio": "drizzle-kit studio",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint --max-warnings 0"
  },
  "type": "module"
}
