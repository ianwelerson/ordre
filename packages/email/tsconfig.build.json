{
  "extends": "./tsconfig.json",
  "include": ["src"],
  "exclude": ["node_modules", "coverage", "dist", ".react-email", "src/**/*.test.{ts,tsx}"],
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "dist",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src"
  }
}
