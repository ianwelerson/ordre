{
  "name": "@ordre/ui",
  "version": "0.0.0",
  "dependencies": {
    "@hookform/resolvers": "^5.9.0",
    "@ordre/core": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0"
  },
  "devDependencies": {
    "@ordre/config": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.0",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./components": "./src/components/index.ts",
    "./config/postcss": "./src/config/postcss.ts",
    "./fonts/*": "./src/fonts/*",
    "./form": "./src/form/index.ts",
    "./helpers/*": "./src/helpers/*.ts",
    "./hooks/*": "./src/hooks/*.ts",
    "./icons": "./src/icons/Icons.tsx",
    "./styles/*": "./src/styles/*.css"
  },
  "peerDependencies": {
    "@storybook/react": "^10.5.6",
    "tailwindcss": "^4.3.3"
  },
  "private": true,
  "scripts": {
    "check-types": "tsc --noEmit",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "generate:component": "turbo gen react-component",
    "lint": "eslint . --max-warnings 0",
    "test:unit": "vitest --coverage",
    "test:unit:ci": "vitest run --coverage",
    "test:unit:ui": "vitest --coverage --ui"
  },
  "type": "module"
}
