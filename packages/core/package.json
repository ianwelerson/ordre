{
  "name": "@ordre/core",
  "version": "0.1.0",
  "dependencies": {
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@ordre/config": "workspace:*",
    "@types/node": "^26.4.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.9.1",
    "tsx": "^4.23.13",
    "vitest": "^4.1.11"
  },
  "exports": {
    "./permissions": "./src/permissions/index.ts",
    "./constants": "./src/constants/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./errors": "./src/errors/index.ts",
    "./enums": "./src/enums/index.ts",
    "./types": "./src/types/index.ts",
    "./utils": "./src/utils/index.ts",
    "./messages": "./src/messages/index.ts",
    "./messages/en": "./src/messages/en/index.ts",
    "./messages/pt": "./src/messages/pt/index.ts"
  },
  "private": true,
  "scripts": {
    "check-types": "tsc",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint --max-warnings 0",
    "test:unit": "vitest --coverage",
    "test:unit:ci": "vitest run --coverage",
    "test:unit:ui": "vitest --coverage --ui"
  },
  "type": "module"
}
