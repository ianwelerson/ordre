{
  "name": "board",
  "version": "0.1.0",
  "dependencies": {
    "@ordre/i18n": "workspace:*",
    "@ordre/ui": "workspace:*",
    "@react-router/node": "7.17.0",
    "@react-router/serve": "7.17.0",
    "i18next": "^26.3.1",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-fetch-backend": "^7.0.0",
    "isbot": "^5.1.42",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-router": "7.17.0",
    "remix-i18next": "^7.5.0"
  },
  "devDependencies": {
    "@ordre/config": "workspace:*",
    "@react-router/dev": "7.17.0",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser-playwright": "^4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/ui": "^4.1.8",
    "eslint": "^10.5.0",
    "playwright": "^1.60.0",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=24"
  },
  "portless": {
    "name": "board.ordre",
    "script": "dev:app"
  },
  "private": true,
  "scripts": {
    "build": "react-router build",
    "check-types": "react-router typegen && tsc",
    "dev": "portless",
    "dev:app": "react-router dev --port ${PORT:-5173} --host ${HOST:-127.0.0.1}",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint --max-warnings 0",
    "start": "PORT=3002 react-router-serve ./build/server/index.js",
    "test:unit": "vitest --coverage",
    "test:unit:ci": "vitest run --coverage",
    "test:unit:ui": "vitest --coverage --ui"
  },
  "type": "module"
}
