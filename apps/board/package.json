{
  "name": "board",
  "version": "0.1.0",
  "dependencies": {
    "@ordre/core": "workspace:*",
    "@ordre/ui": "workspace:*",
    "@react-router/node": "8.3.0",
    "@react-router/serve": "8.3.0",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-fetch-backend": "^8.0.0",
    "isbot": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.12",
    "react-router": "8.3.0",
    "remix-i18next": "^8.0.0"
  },
  "devDependencies": {
    "@ordre/config": "workspace:*",
    "@react-router/dev": "8.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.8.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "portless": {
    "name": "board.ordre",
    "script": "dev:app"
  },
  "private": true,
  "scripts": {
    "build": "react-router build",
    "check-types": "react-router typegen && tsc",
    "dev": "portless",
    "dev:app": "react-router dev --port ${PORT:-5173} --host ${HOST:-127.0.0.1}",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint --max-warnings 0",
    "start": "PORT=3002 react-router-serve ./build/server/index.js",
    "test:unit": "vitest --coverage",
    "test:unit:ci": "vitest run --coverage",
    "test:unit:ui": "vitest --coverage --ui"
  },
  "type": "module"
}
