# Basic
PORT=3000
# Which deployment this is: development | test | staging | production.
# This is the one the app branches on. On a host, set it per environment.
APP_STAGE=development
# Whether to run optimized. Only ever development | test | production - staging
# deploys run with NODE_ENV=production, and the schema enforces that.
# On Railway this is injected as `production` by the builder; leave it unset there.
NODE_ENV=development

# Auth
BETTER_AUTH_SECRET=
# The API's own public origin, never a frontend's. One per stage:
#   staging     https://api.staging.ordre.app
#   production  https://api.ordre.app
BETTER_AUTH_URL=https://api.ordre.localhost

# Resend
RESEND_API_KEY=

# Project
# The frontends allowed to call this API. Both CORS and Better Auth's
# trustedOrigins are built from these, so a missing one shows up as a blocked
# browser request rather than a 404.
APP_BASE_URL=https://ordre.localhost
APP_DASHBOARD_URL=https://dashboard.ordre.localhost
APP_BOARD_URL=https://board.ordre.localhost
APP_DOCS_URL=https://docs.ordre.localhost

# Database: DATABASE_URL is shared infra and lives in the workspace-root .env