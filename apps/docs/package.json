{
  "name": "docs",
  "version": "0.0.0",
  "dependencies": {
    "fumadocs-core": "16.9.3",
    "fumadocs-mdx": "15.0.10",
    "fumadocs-openapi": "^10.9.1",
    "fumadocs-ui": "16.9.3",
    "lucide-react": "^1.16.0",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@ordre/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.2.1",
    "eslint": "^10.4.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "portless": {
    "name": "docs.ordre",
    "script": "docs:dev:app"
  },
  "private": true,
  "scripts": {
    "build": "pnpm docs:openapi && next build",
    "check-types": "pnpm docs:openapi && fumadocs-mdx && next typegen && tsc --noEmit",
    "docs:dev": "portless",
    "docs:dev:app": "concurrently -k -n openapi,next \"node scripts/generate-api-docs.ts --watch\" \"next dev\"",
    "docs:openapi": "node scripts/generate-api-docs.ts",
    "docs:start": "next start",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint --max-warnings 0",
    "postinstall": "node scripts/generate-api-docs.ts && fumadocs-mdx"
  },
  "type": "module"
}
