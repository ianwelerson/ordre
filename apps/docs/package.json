{
  "name": "docs",
  "version": "0.0.0",
  "dependencies": {
    "@ordre/core": "workspace:*",
    "fumadocs-core": "16.10.2",
    "fumadocs-mdx": "15.0.12",
    "fumadocs-openapi": "^11.0.2",
    "fumadocs-ui": "16.10.2",
    "lucide-react": "^1.18.0",
    "next": "^16.2.9",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@ordre/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.3",
    "eslint": "^10.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "^6.0.3"
  },
  "portless": {
    "name": "docs.ordre",
    "script": "docs:dev:app"
  },
  "private": true,
  "scripts": {
    "build": "pnpm docs:openapi && pnpm docs:errors && next build",
    "check-types": "pnpm docs:openapi && pnpm docs:errors && next typegen && fumadocs-mdx && tsc --noEmit",
    "docs:dev": "portless",
    "docs:dev:app": "concurrently -k -n openapi,errors,next \"node scripts/generate-api-docs.ts --watch\" \"node scripts/generate-error-docs.ts --watch\" \"next dev\"",
    "docs:errors": "node scripts/generate-error-docs.ts",
    "docs:openapi": "node scripts/generate-api-docs.ts",
    "docs:start": "next start",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint --max-warnings 0",
    "postinstall": "node scripts/generate-api-docs.ts && node scripts/generate-error-docs.ts && fumadocs-mdx"
  },
  "type": "module"
}
