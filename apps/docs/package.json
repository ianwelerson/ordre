{
  "name": "docs",
  "version": "0.0.0",
  "dependencies": {
    "@ordre/core": "workspace:*",
    "fumadocs-core": "16.14.5",
    "fumadocs-mdx": "15.3.0",
    "fumadocs-openapi": "^11.3.5",
    "fumadocs-ui": "16.14.5",
    "lucide-react": "^1.38.0",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@ordre/config": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "portless": {
    "name": "docs.ordre",
    "script": "docs:dev:app"
  },
  "private": true,
  "scripts": {
    "build": "pnpm docs:openapi && pnpm docs:errors && next build",
    "check-types": "pnpm docs:openapi && pnpm docs:errors && next typegen && fumadocs-mdx && tsc --noEmit",
    "docs:dev": "portless",
    "docs:dev:app": "concurrently -k -n openapi,errors,next \"node scripts/generate-api-docs.ts --watch\" \"node scripts/generate-error-docs.ts --watch\" \"next dev\"",
    "docs:errors": "node scripts/generate-error-docs.ts",
    "docs:openapi": "node scripts/generate-api-docs.ts",
    "docs:start": "next start",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint --max-warnings 0",
    "postinstall": "node scripts/generate-api-docs.ts && node scripts/generate-error-docs.ts && fumadocs-mdx"
  },
  "type": "module"
}
