{
  "name": "marketing",
  "version": "0.1.0",
  "dependencies": {
    "@ordre/core": "workspace:*",
    "@ordre/ui": "workspace:*",
    "@storybook/react": "^10.5.10",
    "@tailwindcss/postcss": "^4.3.3",
    "next": "^16.3.1",
    "next-intl": "^4.13.7",
    "postcss": "^8.5.26",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@ordre/config": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "eslint": "^10.8.1",
    "playwright": "^1.62.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "portless": {
    "name": "ordre",
    "script": "dev:app"
  },
  "private": true,
  "scripts": {
    "build": "next build",
    "check-types": "next typegen && tsc --noEmit",
    "dev": "portless",
    "dev:app": "next dev",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint --max-warnings 0",
    "start": "next start",
    "test:unit": "vitest --coverage",
    "test:unit:ci": "vitest run --coverage",
    "test:unit:ui": "vitest --coverage --ui"
  },
  "type": "module"
}
