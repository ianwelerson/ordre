{
  "name": "storybook-app",
  "version": "0.0.0",
  "dependencies": {
    "@ordre/ui": "workspace:*",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.4.4",
    "@storybook/react": "^10.4.4",
    "@storybook/react-vite": "^10.4.4",
    "@tailwindcss/vite": "^4.3.1",
    "globals": "^17.6.0",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.4.4",
    "vite": "^8.0.16"
  },
  "engines": {
    "node": ">=24"
  },
  "portless": {
    "name": "storybook.ordre",
    "script": "storybook:app"
  },
  "private": true,
  "scripts": {
    "storybook": "portless",
    "storybook:app": "storybook dev --no-open --port ${PORT:-6006} --host ${HOST:-127.0.0.1}",
    "storybook:build": "storybook build"
  },
  "type": "module"
}
