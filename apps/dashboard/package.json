{
  "name": "dashboard",
  "version": "0.1.0",
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.8.8",
    "@ordre/i18n": "workspace:*",
    "@ordre/ui": "workspace:*",
    "@storybook/react": "^10.4.1",
    "@tailwindcss/postcss": "^4.3.0",
    "negotiator": "^1.0.0",
    "next": "^16.2.6",
    "next-intl": "^4.12.0",
    "postcss": "^8.5.15",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0"
  },
  "devDependencies": {
    "@ordre/config": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/negotiator": "^0.6.4",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser-playwright": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "eslint": "^10.4.0",
    "playwright": "^1.60.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "engines": {
    "node": ">=24"
  },
  "private": true,
  "scripts": {
    "build": "next build",
    "check-types": "next typegen && tsc --noEmit",
